# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=waf
POSTGRES_PASSWORD=changeme-use-a-long-random-password
POSTGRES_DB=waf

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=changeme-use-a-different-long-random-password

# --- WAF secret key ----------------------------------------------------------
# Used to sign CSRF tokens and bot-challenge nonces. Generate with:
#   openssl rand -hex 32
WAF_SECRET_KEY=

# --- Initial admin account ----------------------------------------------------
# Optional. If left blank, an account is created with a random password
# that is printed ONCE to `docker compose logs waf` on first startup --
# watch for a line starting "=== INITIAL ADMIN ACCOUNT CREATED ===" and
# change the password immediately after your first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Ports on the HOST machine -------------------------------------------------
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
ADMIN_PORT=9000

# --- TLS (optional) ------------------------------------------------------------
# To serve HTTPS directly, place your certificate and key under ./certs
# (mounted read-only into the container) and set both of these plus
# PROXY_HTTPS_ADDR. Leave all three blank to run HTTP-only, e.g. behind
# your own TLS-terminating load balancer.
TLS_CERT_FILE=
TLS_KEY_FILE=
PROXY_HTTPS_ADDR=

# --- Trusted proxies -------------------------------------------------------------
# Comma-separated CIDRs allowed to set X-Forwarded-For/X-Real-IP (e.g. your
# CDN or load balancer in front of this WAF). Leave blank if the WAF
# receives traffic directly from the internet -- forwarded headers are
# NEVER trusted otherwise, which is what correctly attributes attacks to
# the real client IP instead of letting it be spoofed.
TRUSTED_PROXIES=

# --- Behaviour -----------------------------------------------------------------
# If Redis becomes unreachable, should the WAF fail open (allow traffic
# through unprotected) or fail closed (block everything)? Default is
# fail-open so a cache outage cannot take every protected site offline;
# set to true only if you would rather your sites go fully offline than
# run even briefly without rate limiting.
FAIL_OPEN_ON_INFRA_ERROR=false

# Set to false ONLY for local HTTP-only development -- this controls the
# Secure flag on session/CSRF/bot-pass cookies.
COOKIE_SECURE=true

LOG_LEVEL=info
